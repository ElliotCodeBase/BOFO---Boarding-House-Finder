<?xml version="1.0" encoding="UTF-8"?>
<!-- Merged by GluonFX into the generated manifest. Adjust package to match your release config. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.bofo.finder" android:versionCode="79" android:versionName="1.19.15">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <application android:label="BOFO Finder" android:usesCleartextTraffic="false">
    <activity android:name="com.gluonhq.helloandroid.MainActivity" android:exported="true" android:launchMode="singleTask">
      <!-- Google OAuth return: bofo://auth-callback?code=... (must also be added to Supabase > Auth > URL Configuration > Redirect URLs) -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="bofo" android:host="auth-callback"/>
      </intent-filter>
    </activity>
    <!-- Google account sheet inside the app (no browser). Opened by bofo://google-signin, see NativeGoogle.java -->
    <activity android:name="com.bofo.finder.android.GoogleSignInActivity" android:exported="true"
              android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="bofo" android:host="google-signin"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
