+    }
+
+    private void open(FrameLayout body, int tab) {
+        body.removeAllViews();
+        View v = tab == 0 ? new HomeScreen(this, access) : tab == 1 ? new IdScreen(this, access) : new ReportsScreen(this, access);
+        body.addView(v, new FrameLayout.LayoutParams(-1, -1));
+    }
