diff -ruN a/shared/src/main/java/com/bofo/shared/Api.java b/shared/src/main/java/com/bofo/shared/Api.java
--- a/shared/src/main/java/com/bofo/shared/Api.java	1970-01-01 00:00:00.000000000 +0000
+++ b/shared/src/main/java/com/bofo/shared/Api.java	2026-11-06 11:13:43.515260507 +0000
@@ -0,0 +1,88 @@
+package com.bofo.shared;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.function.Supplier;
+
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+
+/**
+ * Thin Supabase REST client shared by the apps (anon key + the signed-in user's JWT only; never a service_role key).
+ * Blocking: call it through {@link Async}. Every request carries x-bofo-client so the server can tell the admin app from the user app.
+ */
+public final class Api {
+    private static final Api I = new Api();
+    public static Api get() { return I; }
+
+    public static class ApiException extends RuntimeException {
+        public final int status; public final String body;
+        public ApiException(int status, String body) { super("HTTP " + status); this.status = status; this.body = body == null ? "" : body; }
+    }
+
+    private volatile String url = "", anon = "", version = "0", client = "user";
+    private volatile Supplier<String> token = () -> null;
+
+    public void init(String supabaseUrl, String anonKey, String appVersion, String clientName) {
+        url = supabaseUrl == null ? "" : supabaseUrl; anon = anonKey == null ? "" : anonKey; version = appVersion; client = clientName;
+    }
+    public void setTokenProvider(Supplier<String> p) { token = p; }
+
+    private Request.Builder base(String path, boolean authed) {
+        if (url.isEmpty()) throw new IllegalStateException("supabase.url is missing (bofo-android/local.properties)");
+        String t = authed ? token.get() : null;
+        return new Request.Builder().url(url + path).header("apikey", anon)
+                .header("x-bofo-app-version", version).header("x-bofo-client", client)
+                .header("Authorization", "Bearer " + (t != null ? t : anon));
+    }
+
+    private String send(Request r, int timeout) throws Exception {
+        try (Response resp = Http.client(timeout).newCall(r).execute()) {
+            String text = resp.body() == null ? "" : resp.body().string();
+            if (resp.code() >= 300) throw new ApiException(resp.code(), text);
+            return text;
+        }
+    }
+
+    public JSONArray select(String table, String query) throws Exception {
+        return new JSONArray(send(base("/rest/v1/" + table + (query == null || query.isEmpty() ? "" : "?" + query), true)
+                .header("Accept", "application/json").get().build(), 15));
+    }
+
+    /** Calls a database function. Returns the JSON text ("" when the function returns nothing). */
+    public String rpc(String fn, JSONObject args) throws Exception {
+        return send(base("/rest/v1/rpc/" + fn, true).post(RequestBody.create(Http.JSON, args.toString())).build(), 30);
+    }
+    public JSONObject rpcObject(String fn, JSONObject args) throws Exception {
+        String b = rpc(fn, args);
+        return b == null || b.trim().isEmpty() || !b.trim().startsWith("{") ? new JSONObject() : new JSONObject(b);
+    }
+
+    public JSONObject authPost(String path, JSONObject body) throws Exception {
+        return new JSONObject(send(base("/auth/v1/" + path, false).post(RequestBody.create(Http.JSON, body.toString())).build(), 30));
+    }
+    /** Auth endpoints that need the signed-in user (factors, challenge, verify). */
+    public String authCall(String method, String path, JSONObject body) throws Exception {
+        Request.Builder rb = base("/auth/v1/" + path, true);
+        if ("GET".equals(method)) rb.get(); else rb.post(RequestBody.create(Http.JSON, body == null ? "{}" : body.toString()));
+        return send(rb.build(), 30);
+    }
+    public void logout() {
+        try { send(base("/auth/v1/logout", true).post(RequestBody.create(null, new byte[0])).build(), 10); } catch (Exception ignored) { }
+    }
+    /** Time-limited link for a private bucket (ID photos). */
+    public String signedUrl(String bucket, String path, int seconds) throws Exception {
+        String b = send(base("/storage/v1/object/sign/" + bucket + "/" + path, true)
+                .post(RequestBody.create(Http.JSON, new JSONObject().put("expiresIn", seconds).toString())).build(), 15);
+        return url + "/storage/v1" + new JSONObject(b).getString("signedURL");
+    }
+    /** Downloads bytes with the user's JWT (used for signed links, which carry their own token). */
+    public byte[] fetchBytes(String fullUrl) throws Exception {
+        try (Response r = Http.client(30).newCall(new Request.Builder().url(fullUrl).build()).execute()) {
+            if (r.code() >= 300 || r.body() == null) throw new ApiException(r.code(), "");
+            return r.body().bytes();
+        }
+    }
+}
diff -ruN a/shared/src/main/java/com/bofo/shared/Async.java b/shared/src/main/java/com/bofo/shared/Async.java
--- a/shared/src/main/java/com/bofo/shared/Async.java	1970-01-01 00:00:00.000000000 +0000
+++ b/shared/src/main/java/com/bofo/shared/Async.java	2026-11-06 11:13:43.515218258 +0000
@@ -0,0 +1,50 @@
+package com.bofo.shared;
+
+import android.os.Handler;
+import android.os.Looper;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.function.Consumer;
+
+/** Runs blocking work off the main thread, then delivers the result on the main thread (replaces the JavaFX Platform.runLater version). */
+public final class Async {
+    private static final ExecutorService POOL = Executors.newFixedThreadPool(6, r -> {
+        Thread t = new Thread(r, "bofo-io"); t.setDaemon(true); return t;
+    });
+    private static volatile Handler main;
+    private Async() {}
+
+    public interface Work<T> { T run() throws Exception; }
+
+    /** Posts to the main thread. */
+    public static void post(Runnable r) {
+        Handler h = main;
+        if (h == null) { h = new Handler(Looper.getMainLooper()); main = h; }   // created lazily so plain JVM unit tests can load this class
+        h.post(r);
+    }
+
+    public static <T> void run(Work<T> work, Consumer<T> ok, Consumer<Throwable> fail) {
+        POOL.submit(() -> {
+            try { T r = work.run(); post(() -> ok.accept(r)); }
+            catch (Throwable e) { post(() -> { if (fail != null) fail.accept(e); }); }
+        });
+    }
+    public static <T> void run(Work<T> work, Consumer<T> ok) { run(work, ok, e -> android.util.Log.w("BOFO", "Async failed", e)); }
+    public static ExecutorService pool() { return POOL; }
+
+    /**
+     * For work that a task ALREADY running on {@link #pool()} starts and then waits for (e.g. "load the list + the featured places in parallel").
+     * If those sub-tasks went into the same 6-thread pool, six waiting tasks would block every thread and the sub-tasks behind them
+     * could never run: every screen then sat on its loading skeleton forever. This pool grows as needed, so a waiting task never starves its own sub-tasks.
+     */
+    private static final ExecutorService FANOUT = Executors.newCachedThreadPool(r -> {
+        Thread t = new Thread(r, "bofo-fanout"); t.setDaemon(true); return t;
+    });
+    public static ExecutorService fanout() { return FANOUT; }
+    public static void bg(Runnable r) { POOL.submit(r); }
+    public static ScheduledExecutorService scheduler() {
+        return Executors.newSingleThreadScheduledExecutor(r -> { Thread t = new Thread(r, "bofo-poll"); t.setDaemon(true); return t; });
+    }
+}
diff -ruN a/shared/src/main/java/com/bofo/shared/AutoLockRules.java b/shared/src/main/java/com/bofo/shared/AutoLockRules.java
--- a/shared/src/main/java/com/bofo/shared/AutoLockRules.java	1970-01-01 00:00:00.000000000 +0000
+++ b/shared/src/main/java/com/bofo/shared/AutoLockRules.java	2026-11-06 11:13:43.515202442 +0000
@@ -0,0 +1,18 @@
+package com.bofo.shared;
+
+/** v2.9.0: when the admin tools lock again after the app was in the background (pure, unit tested). */
+public final class AutoLockRules {
+    public static final long LIMIT_MS = 5 * 60 * 1000L;
+    private AutoLockRules() {}
+
+    /**
+     * @param enabled      the Settings switch (admin only, default on)
+     * @param stoppedAtMs  when the app went to the background, 0 = not recorded
+     * @param nowMs        current time
+     * A clock set back to before the stop counts as "lock" (fail closed).
+     */
+    public static boolean shouldLock(boolean enabled, long stoppedAtMs, long nowMs) {
+        if (!enabled || stoppedAtMs <= 0) return false;
+        return nowMs < stoppedAtMs || nowMs - stoppedAtMs >= LIMIT_MS;
+    }
+}
diff -ruN a/shared/src/main/java/com/bofo/shared/Http.java b/shared/src/main/java/com/bofo/shared/Http.java
--- a/shared/src/main/java/com/bofo/shared/Http.java	1970-01-01 00:00:00.000000000 +0000
+++ b/shared/src/main/java/com/bofo/shared/Http.java	2026-11-06 11:13:43.515231285 +0000
@@ -0,0 +1,30 @@
+package com.bofo.shared;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+
+/** The one shared OkHttp client (java.net.http does not exist on Android). OkHttp adds and unzips gzip by itself. */
+public final class Http {
+    public static final MediaType JSON = MediaType.parse("application/json; charset=utf-8");
+
+    private static final OkHttpClient CLIENT = new OkHttpClient.Builder()
+            .connectTimeout(12, TimeUnit.SECONDS)
+            .readTimeout(30, TimeUnit.SECONDS)
+            .writeTimeout(30, TimeUnit.SECONDS)
+            .callTimeout(40, TimeUnit.SECONDS)
+            .build();
+    private static final ConcurrentMap<Integer, OkHttpClient> BY_TIMEOUT = new ConcurrentHashMap<>();
+    private Http() {}
+
+    public static OkHttpClient client() { return CLIENT; }
+
+    /** Same client (shared connections) with a shorter whole-call limit, e.g. 15 s for reads that must fail fast. */
+    public static OkHttpClient client(int callTimeoutSeconds) {
+        return BY_TIMEOUT.computeIfAbsent(callTimeoutSeconds,
+                s -> CLIENT.newBuilder().callTimeout(s, TimeUnit.SECONDS).build());
+    }
+}
diff -ruN a/shared/src/main/java/com/bofo/shared/PermissionRules.java b/shared/src/main/java/com/bofo/shared/PermissionRules.java
--- a/shared/src/main/java/com/bofo/shared/PermissionRules.java	1970-01-01 00:00:00.000000000 +0000
+++ b/shared/src/main/java/com/bofo/shared/PermissionRules.java	2026-11-06 11:13:43.515168762 +0000
@@ -0,0 +1,108 @@
+package com.bofo.shared;
+
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Admin permission model, client side (Stage 2). A MIRROR of supabase/migrations/039_admin_roles.sql, used only to decide what to SHOW.
+ * The server (has_permission / require_permission) is the real gate and always wins; keep the two lists identical.
+ * Pure Java, no Android classes, so it is unit-tested (PermissionRulesTest) and moves to the shared module in Stage 3.
+ */
+public final class PermissionRules {
+    private PermissionRules() {}
+
+    public static final String LEGACY_ADMIN = "legacy_admin";
+    public static final String DASHBOARD_VIEW = "dashboard_view", ID_REVIEW = "id_review", ID_VIEW_RAW = "id_view_raw",
+            REPORTS_VIEW = "reports_view", REPORTS_ACT = "reports_act", SUSPEND_SHORT = "suspend_short", SUSPEND_LONG = "suspend_long",
+            BAN_PERMANENT = "ban_permanent", UNBAN = "unban", BANNED_VIEW = "banned_view", LISTING_TAKEDOWN = "listing_takedown",
+            AI_ANSWER = "ai_answer", AI_LOG_VIEW = "ai_log_view", AI_SETTINGS = "ai_settings",
+            PAYMENTS_VIEW = "payments_view", PAYMENTS_MANAGE = "payments_manage", CSV_EXPORT = "csv_export",
+            AUDIT_VIEW_OWN = "audit_view_own", AUDIT_VIEW_ALL = "audit_view_all", MEMBERS_MANAGE = "members_manage",
+            ANNOUNCE_PUSH = "announce_push", MFA_MANAGE = "mfa_manage", APP_CONFIG = "app_config", USER_DATA_DELETE = "user_data_delete",
+            APPROVALS_REQUEST = "approvals_request", APPROVALS_DECIDE = "approvals_decide";
+
+    /** Same order as admin_permission_keys() in 039. */
+    public static final Set<String> ALL = Collections.unmodifiableSet(new LinkedHashSet<>(Arrays.asList(
+            LEGACY_ADMIN, DASHBOARD_VIEW, ID_REVIEW, ID_VIEW_RAW, REPORTS_VIEW, REPORTS_ACT, SUSPEND_SHORT, SUSPEND_LONG, BAN_PERMANENT, UNBAN,
+            BANNED_VIEW, LISTING_TAKEDOWN, AI_ANSWER, AI_LOG_VIEW, AI_SETTINGS, PAYMENTS_VIEW, PAYMENTS_MANAGE, CSV_EXPORT, AUDIT_VIEW_OWN,
+            AUDIT_VIEW_ALL, MEMBERS_MANAGE, ANNOUNCE_PUSH, MFA_MANAGE, APP_CONFIG, USER_DATA_DELETE, APPROVALS_REQUEST, APPROVALS_DECIDE)));
+
+    /** Same as admin_owner_only_keys() in 039: the 12 owner-only items. */
+    public static final Set<String> OWNER_ONLY = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(
+            MEMBERS_MANAGE, PAYMENTS_VIEW, PAYMENTS_MANAGE, CSV_EXPORT, BAN_PERMANENT, UNBAN, LISTING_TAKEDOWN, AUDIT_VIEW_ALL,
+            AI_SETTINGS, ANNOUNCE_PUSH, AI_LOG_VIEW, MFA_MANAGE, APP_CONFIG, USER_DATA_DELETE, ID_VIEW_RAW)));
+
+    private static final Map<String, Set<String>> PRESETS = new HashMap<>();
+    static {
+        PRESETS.put("owner", ALL);
+        PRESETS.put("legacy_admin", ALL);
+        PRESETS.put("admin", set(DASHBOARD_VIEW, ID_REVIEW, REPORTS_VIEW, REPORTS_ACT, SUSPEND_SHORT, SUSPEND_LONG, BANNED_VIEW,
+                AI_ANSWER, AUDIT_VIEW_OWN, APPROVALS_REQUEST, APPROVALS_DECIDE));
+        PRESETS.put("moderator", set(DASHBOARD_VIEW, ID_REVIEW, REPORTS_VIEW, REPORTS_ACT, SUSPEND_SHORT, BANNED_VIEW,
+                AI_ANSWER, AUDIT_VIEW_OWN, APPROVALS_REQUEST));
+        PRESETS.put("support", set(DASHBOARD_VIEW, REPORTS_VIEW, BANNED_VIEW, AI_ANSWER, AUDIT_VIEW_OWN));
+    }
+
+    /** Longest suspension (hours) a role without suspend_long may apply. Same 168 as admin_review_report in 040. */
+    public static final int SHORT_SUSPEND_MAX_HOURS = 168;
+
+    private static Set<String> set(String... k) { return Collections.unmodifiableSet(new HashSet<>(Arrays.asList(k))); }
+
+    /** The preset for a role key, or an empty set for null/unknown (unknown = no access). */
+    public static Set<String> preset(String role) {
+        Set<String> p = role == null ? null : PRESETS.get(role);
+        return p == null ? Collections.<String>emptySet() : p;
+    }
+
+    /** What a member can do: preset + grants - denies. The owner always keeps everything. Unknown keys are ignored. */
+    public static boolean has(String role, Collection<String> grants, Collection<String> denies, String key) {
+        if (key == null || !ALL.contains(key)) return false;
+        if ("owner".equals(role)) return true;
+        Set<String> p = preset(role);
+        boolean granted = p.contains(key) || (grants != null && grants.contains(key));
+        return granted && !(denies != null && denies.contains(key));
+    }
+
+    /** True when the key is on the owner-only list. */
+    public static boolean ownerOnly(String key) { return key != null && OWNER_ONLY.contains(key); }
+
+    /** True when a per-person grant may be given to this role (owner-only keys never go to a sub-admin). */
+    public static boolean canGrant(String role, String key) {
+        if (key == null || !ALL.contains(key)) return false;
+        return "owner".equals(role) || !OWNER_ONLY.contains(key);
+    }
+
+    /** The permission needed to suspend for this many hours. */
+    public static String suspendKey(int hours) { return hours > SHORT_SUSPEND_MAX_HOURS ? SUSPEND_LONG : SUSPEND_SHORT; }
+
+    /** What a person without this permission should see: a "Request approval" button instead of the action. */
+    public static boolean needsApproval(Collection<String> perms, String key) {
+        return perms != null && perms.contains(APPROVALS_REQUEST) && !perms.contains(key);
+    }
+
+    /** True when this account can decide the request (needs approvals_decide AND the permission of the action itself). */
+    public static boolean canDecide(Collection<String> perms, String actionKey, String requesterId, String myId) {
+        return perms != null && perms.contains(APPROVALS_DECIDE) && perms.contains(actionKey)
+                && requesterId != null && !requesterId.equals(myId);
+    }
+
+    /** The permission an approval request needs from the decider, by kind (same names as admin_approvals.kind). */
+    public static String approvalKey(String kind) {
+        if ("report_ban".equals(kind)) return BAN_PERMANENT;
+        if ("report_suspend".equals(kind)) return SUSPEND_LONG;
+        if ("report_takedown".equals(kind)) return LISTING_TAKEDOWN;
+        return null;
+    }
+
+    /** Conflict check mirrored from admin_review_report: nobody decides a report about themselves or by themselves. */
+    public static boolean conflict(String me, String reporter, String reported, String reportedInvitedBy) {
+        if (me == null) return true;
+        return me.equals(reporter) || me.equals(reported) || me.equals(reportedInvitedBy);
+    }
+}
diff -ruN a/shared/src/main/java/com/bofo/shared/SessionStore.java b/shared/src/main/java/com/bofo/shared/SessionStore.java
--- a/shared/src/main/java/com/bofo/shared/SessionStore.java	1970-01-01 00:00:00.000000000 +0000
+++ b/shared/src/main/java/com/bofo/shared/SessionStore.java	2026-11-06 11:13:43.515244213 +0000
@@ -0,0 +1,87 @@
+package com.bofo.shared;
+
+import android.content.Context;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.KeyStore;
+import java.util.Optional;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Persists the Supabase session ENCRYPTED (AES-256-GCM) in the app's private files folder. The key is created inside the
+ * Android Keystore and never leaves it (the desktop version kept the key in a sibling file). Same API as before:
+ * save / load / clear. Uninstalling the app (or a lost key) simply means "signed out".
+ */
+public final class SessionStore {
+    private static final String KEY_ALIAS = "bofo_admin_session_key";
+    private static final String KEYSTORE = "AndroidKeyStore";
+    private static final int IV_BYTES = 12;
+
+    private final File dataFile;
+
+    public SessionStore(Context ctx) {
+        File dir = new File(ctx.getFilesDir(), "admin_session");
+        dir.mkdirs();
+        dataFile = new File(dir, "admin_s.bin");
+    }
+
+    private static SecretKey key() throws Exception {
+        KeyStore ks = KeyStore.getInstance(KEYSTORE);
+        ks.load(null);
+        if (ks.containsAlias(KEY_ALIAS)) return (SecretKey) ks.getKey(KEY_ALIAS, null);
+        KeyGenerator g = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, KEYSTORE);
+        g.init(new KeyGenParameterSpec.Builder(KEY_ALIAS, KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(256)
+                .build());
+        return g.generateKey();
+    }
+
+    public synchronized void save(JSONObject session) {
+        try {
+            Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+            c.init(Cipher.ENCRYPT_MODE, key());                       // the Keystore picks a fresh random IV
+            byte[] iv = c.getIV();
+            byte[] enc = c.doFinal(session.toString().getBytes(StandardCharsets.UTF_8));
+            byte[] out = new byte[iv.length + enc.length];
+            System.arraycopy(iv, 0, out, 0, iv.length);
+            System.arraycopy(enc, 0, out, iv.length, enc.length);
+            File tmp = new File(dataFile.getPath() + ".tmp");
+            try (OutputStream o = new FileOutputStream(tmp)) { o.write(out); }
+            if (!tmp.renameTo(dataFile)) { dataFile.delete(); tmp.renameTo(dataFile); }
+        } catch (Exception e) { throw new IllegalStateException("Cannot save session", e); }
+    }
+
+    public synchronized Optional<JSONObject> load() {
+        try {
+            if (!dataFile.exists()) return Optional.empty();
+            byte[] all;
+            try (InputStream in = new FileInputStream(dataFile)) {
+                ByteArrayOutputStream buf = new ByteArrayOutputStream();
+                byte[] b = new byte[4096]; int n;
+                while ((n = in.read(b)) > 0) buf.write(b, 0, n);
+                all = buf.toByteArray();
+            }
+            Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+            c.init(Cipher.DECRYPT_MODE, key(), new GCMParameterSpec(128, all, 0, IV_BYTES));
+            return Optional.of(new JSONObject(new String(c.doFinal(all, IV_BYTES, all.length - IV_BYTES), StandardCharsets.UTF_8)));
+        } catch (Exception e) { clear(); return Optional.empty(); }
+    }
+
+    public synchronized void clear() { dataFile.delete(); }
+}
