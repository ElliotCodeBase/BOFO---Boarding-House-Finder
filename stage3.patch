diff -ruN a/app-admin/build.gradle b/app-admin/build.gradle
--- a/app-admin/build.gradle	1970-01-01 00:00:00.000000000 +0000
+++ b/app-admin/build.gradle	2026-11-06 11:13:43.515804895 +0000
@@ -0,0 +1,66 @@
+plugins { id 'com.android.application' }
+
+// FCM for the admin app: put the admin app's google-services.json (package com.bofo.admin) in app-admin/ (git-ignored).
+// Without it the plugin is skipped and the app still builds, just without push (push targeting arrives in Stage 4).
+// Note: the google-services plugin must be on the classpath: it is already declared (apply false) in bofo-android/build.gradle.
+if (file('google-services.json').exists()) { apply plugin: 'com.google.gms.google-services' }
+
+// Same public config as the main app (same Supabase project). Never put a service_role key anywhere.
+def cfgProps = new Properties()
+[rootProject.file('../src/main/resources/com/bofo/finder/config.properties'),
+ rootProject.file('../src/main/resources/com/bofo/finder/config.local.properties'),
+ rootProject.file('local.properties')].each { f -> if (f.exists()) f.withInputStream { cfgProps.load(it) } }
+def cfg = { String k -> (cfgProps.getProperty(k) ?: System.getenv(k.toUpperCase().replace('.', '_')) ?: '').trim().replace('\\', '\\\\').replace('"', '\\"') }
+
+// Separate upload key for the admin app (never the user app's key). Env names: BOFO_ADMIN_KEYSTORE_FILE / _PASSWORD / BOFO_ADMIN_KEY_ALIAS / BOFO_ADMIN_KEY_PASSWORD.
+def adminStore = System.getenv('BOFO_ADMIN_KEYSTORE_FILE') ?: ''
+def hasAdminKey = adminStore && rootProject.file(adminStore).exists()
+
+android {
+    namespace 'com.bofo.admin'
+    compileSdk 36
+    defaultConfig {
+        applicationId 'com.bofo.admin'
+        minSdk 26
+        targetSdk 36
+        versionCode 20907
+        versionName '2.9.7'
+        buildConfigField 'String', 'SUPABASE_URL', "\"${cfg('supabase.url')}\""
+        buildConfigField 'String', 'SUPABASE_ANON_KEY', "\"${cfg('supabase.anonKey')}\""
+        buildConfigField 'String', 'GOOGLE_WEB_CLIENT_ID', "\"${cfg('google.webClientId')}\""
+    }
+    signingConfigs {
+        if (hasAdminKey) {
+            release {
+                storeFile rootProject.file(adminStore)
+                storePassword System.getenv('BOFO_ADMIN_KEYSTORE_PASSWORD')
+                keyAlias System.getenv('BOFO_ADMIN_KEY_ALIAS')
+                keyPassword System.getenv('BOFO_ADMIN_KEY_PASSWORD')
+            }
+        }
+    }
+    buildTypes {
+        debug { applicationIdSuffix '.debug' }
+        release {
+            minifyEnabled true
+            shrinkResources true
+            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
+            if (hasAdminKey) signingConfig signingConfigs.release
+        }
+    }
+    compileOptions { sourceCompatibility JavaVersion.VERSION_17; targetCompatibility JavaVersion.VERSION_17 }
+    buildFeatures { buildConfig true }
+}
+
+dependencies {
+    implementation project(':shared')
+    implementation 'androidx.appcompat:appcompat:1.7.1'
+    implementation 'com.google.android.material:material:1.13.0'
+    implementation 'androidx.credentials:credentials:1.5.0'
+    implementation 'androidx.credentials:credentials-play-services-auth:1.5.0'
+    implementation 'com.google.android.libraries.identity.googleid:googleid:1.1.1'
+    implementation 'androidx.biometric:biometric:1.1.0'
+    implementation platform('com.google.firebase:firebase-bom:33.7.0')
+    implementation 'com.google.firebase:firebase-messaging'
+    testImplementation 'junit:junit:4.13.2'
+}
