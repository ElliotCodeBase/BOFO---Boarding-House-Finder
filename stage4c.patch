diff -ruN a/shared/src/main/java/com/bofo/shared/AiUnansweredRules.java b/shared/src/main/java/com/bofo/shared/AiUnansweredRules.java
--- a/shared/src/main/java/com/bofo/shared/AiUnansweredRules.java	1970-01-01 08:00:00.000000000 +0800
+++ b/shared/src/main/java/com/bofo/shared/AiUnansweredRules.java	2026-11-06 21:22:11.534009379 +0800
@@ -0,0 +1,69 @@
+package com.bofo.shared;
+
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * "Needs attention" (ai_answer), moved to shared in 2.9.10: the pure logic for the list of questions BOFO could not answer well (table ai_unanswered, migration 020).
+ * No Android classes, so it runs in plain JVM unit tests (AiUnansweredRulesTest).
+ */
+public final class AiUnansweredRules {
+    private AiUnansweredRules() {}
+
+    /** Newest rows loaded at once. */
+    public static final int LIMIT = 50;
+    public static final String COLUMNS = "id,created_at,reason,intent,lang,message";
+
+    /** The reasons the Edge Function writes (check constraint of ai_unanswered.reason); ALL = no filter. */
+    public enum Reason {
+        ALL(null), DEGRADED("degraded"), CLARIFY("clarify"), NOT_FOUND("not_found"), OFF_TOPIC("off_topic"), THUMBS_DOWN("thumbs_down");
+        public final String key;
+        Reason(String key) { this.key = key; }
+
+        /** The reason for a column value; null or an unknown text gives ALL (so a new reason on the server never crashes the screen). */
+        public static Reason of(String key) {
+            if (key != null) for (Reason r : values()) if (key.equals(r.key)) return r;
+            return ALL;
+        }
+    }
+
+    /** One row. {@code message} is empty when the server did not store the text (AI chat monitor off, or a thumbs down). */
+    public record Row(String id, String createdAt, String reason, String intent, String lang, String message) {
+        public Row {
+            id = nz(id); createdAt = nz(createdAt); reason = nz(reason); intent = nz(intent); lang = nz(lang); message = nz(message).trim();
+        }
+        public Reason kind() { return Reason.of(reason); }
+        public boolean hasText() { return !message.isEmpty(); }
+    }
+
+    private static String nz(String s) { return s == null ? "" : s; }
+
+    /** Shown only to roles with ai_answer (RLS policy ai_unanswered_admin_read in 040 is the real gate: others get 0 rows). */
+    public static boolean canSee(String role, java.util.Collection<String> grants, java.util.Collection<String> denies) {
+        return PermissionRules.has(role, grants, denies, PermissionRules.AI_ANSWER);
+    }
+
+    /** PostgREST query for the newest rows, optionally of one reason. */
+    public static String query(Reason r) {
+        String q = "select=" + COLUMNS + "&order=created_at.desc&limit=" + LIMIT;
+        if (r != null && r.key != null) q += "&reason=eq." + r.key;
+        return q;
+    }
+
+    /** How many of the loaded rows each reason has (every reason is present, 0 when none). */
+    public static Map<Reason, Integer> counts(List<Row> rows) {
+        Map<Reason, Integer> m = new EnumMap<>(Reason.class);
+        for (Reason r : Reason.values()) if (r != Reason.ALL) m.put(r, 0);
+        if (rows != null) for (Row row : rows) { Reason k = row.kind(); if (k != Reason.ALL) m.merge(k, 1, Integer::sum); }
+        return m;
+    }
+
+    /** Same list without rows of an unknown reason, newest first as the server sent them. */
+    public static List<Row> known(List<Row> rows) {
+        List<Row> out = new ArrayList<>();
+        if (rows != null) for (Row r : rows) if (r.kind() != Reason.ALL) out.add(r);
+        return out;
+    }
+}
diff -ruN a/shared/src/main/java/com/bofo/shared/CsvRules.java b/shared/src/main/java/com/bofo/shared/CsvRules.java
--- a/shared/src/main/java/com/bofo/shared/CsvRules.java	1970-01-01 08:00:00.000000000 +0800
+++ b/shared/src/main/java/com/bofo/shared/CsvRules.java	2026-11-06 21:22:11.527322308 +0800
@@ -0,0 +1,32 @@
+package com.bofo.shared;
+
+import java.util.List;
+
+/** Moved to shared in 2.9.10 (admin app). Builds the CSV text for the admin exports (pure, unit tested). UTF-8 BOM so Excel opens it; cells that could run as a formula are neutralised. */
+public final class CsvRules {
+    public static final String BOM = "\uFEFF";
+    private CsvRules() {}
+
+    /** One cell: line breaks become spaces; a cell starting with = + - @ or a tab gets a leading apostrophe; commas and quotes are escaped. */
+    public static String cell(String s) {
+        String v = s == null ? "" : s.replace("\r", " ").replace("\n", " ");
+        if (!v.isEmpty()) {
+            char c = v.charAt(0);
+            if (c == '=' || c == '+' || c == '-' || c == '@' || c == '\t') v = "'" + v;
+        }
+        if (v.indexOf(',') >= 0 || v.indexOf('"') >= 0) v = "\"" + v.replace("\"", "\"\"") + "\"";
+        return v;
+    }
+
+    public static String line(String... cells) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < cells.length; i++) { if (i > 0) sb.append(','); sb.append(cell(cells[i])); }
+        return sb.append("\r\n").toString();
+    }
+
+    public static String document(String[] header, List<String[]> rows) {
+        StringBuilder sb = new StringBuilder(BOM).append(line(header));
+        for (String[] r : rows) sb.append(line(r));
+        return sb.toString();
+    }
+}
diff -ruN a/shared/src/test/java/com/bofo/shared/AiUnansweredRulesTest.java b/shared/src/test/java/com/bofo/shared/AiUnansweredRulesTest.java
--- a/shared/src/test/java/com/bofo/shared/AiUnansweredRulesTest.java	1970-01-01 08:00:00.000000000 +0800
+++ b/shared/src/test/java/com/bofo/shared/AiUnansweredRulesTest.java	2026-11-06 21:22:11.545719928 +0800
@@ -0,0 +1,58 @@
+package com.bofo.shared;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import com.bofo.shared.AiUnansweredRules.Reason;
+import com.bofo.shared.AiUnansweredRules.Row;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+
+public class AiUnansweredRulesTest {
+    @Test public void rolesWithAiAnswerSeeTheScreen() {
+        assertTrue(AiUnansweredRules.canSee("owner", null, null));
+        assertTrue(AiUnansweredRules.canSee("support", null, null));
+        assertTrue(AiUnansweredRules.canSee("moderator", null, null));
+        assertFalse(AiUnansweredRules.canSee("support", null, java.util.Arrays.asList("ai_answer")));
+        assertFalse(AiUnansweredRules.canSee(null, null, null));
+        assertFalse(AiUnansweredRules.canSee("nobody", null, null));
+    }
+
+    @Test public void queryFiltersByReason() {
+        assertEquals("select=id,created_at,reason,intent,lang,message&order=created_at.desc&limit=50", AiUnansweredRules.query(Reason.ALL));
+        assertEquals("select=id,created_at,reason,intent,lang,message&order=created_at.desc&limit=50", AiUnansweredRules.query(null));
+        assertTrue(AiUnansweredRules.query(Reason.THUMBS_DOWN).endsWith("&reason=eq.thumbs_down"));
+        assertTrue(AiUnansweredRules.query(Reason.NOT_FOUND).endsWith("&reason=eq.not_found"));
+    }
+
+    @Test public void unknownReasonNeverCrashes() {
+        assertEquals(Reason.ALL, Reason.of(null));
+        assertEquals(Reason.ALL, Reason.of("something_new"));
+        assertEquals(Reason.CLARIFY, Reason.of("clarify"));
+    }
+
+    @Test public void rowIsNullSafe() {
+        Row r = new Row(null, null, null, null, null, null);
+        assertFalse(r.hasText());
+        assertEquals(Reason.ALL, r.kind());
+        assertTrue(new Row("1", "t", "degraded", "search", "tl", "  malapit  ").hasText());
+        assertEquals("malapit", new Row("1", "t", "degraded", "search", "tl", "  malapit  ").message());
+    }
+
+    @Test public void countsAndKnown() {
+        List<Row> rows = Arrays.asList(
+                new Row("1", "t", "clarify", "", "", "a"), new Row("2", "t", "clarify", "", "", "b"),
+                new Row("3", "t", "thumbs_down", "", "", ""), new Row("4", "t", "future_reason", "", "", "x"));
+        Map<Reason, Integer> m = AiUnansweredRules.counts(rows);
+        assertEquals(2, (int) m.get(Reason.CLARIFY));
+        assertEquals(1, (int) m.get(Reason.THUMBS_DOWN));
+        assertEquals(0, (int) m.get(Reason.DEGRADED));
+        assertEquals(3, AiUnansweredRules.known(rows).size());
+        assertEquals(0, (int) AiUnansweredRules.counts(null).get(Reason.OFF_TOPIC));
+    }
+}
diff -ruN a/shared/src/test/java/com/bofo/shared/CsvRulesTest.java b/shared/src/test/java/com/bofo/shared/CsvRulesTest.java
--- a/shared/src/test/java/com/bofo/shared/CsvRulesTest.java	1970-01-01 08:00:00.000000000 +0800
+++ b/shared/src/test/java/com/bofo/shared/CsvRulesTest.java	2026-11-06 21:22:11.539938827 +0800
@@ -0,0 +1,31 @@
+package com.bofo.shared;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Arrays;
+import java.util.Collections;
+import org.junit.Test;
+
+public class CsvRulesTest {
+    @Test public void formulaCellsAreNeutralised() {
+        assertEquals("'=1+1", CsvRules.cell("=1+1"));
+        assertEquals("'+5", CsvRules.cell("+5"));
+        assertEquals("'-5", CsvRules.cell("-5"));
+        assertEquals("'@x", CsvRules.cell("@x"));
+        assertEquals("'\tx", CsvRules.cell("\tx"));
+        assertEquals("scam", CsvRules.cell("scam"));
+    }
+    @Test public void escaping() {
+        assertEquals("\"a,b\"", CsvRules.cell("a,b"));
+        assertEquals("\"say \"\"hi\"\"\"", CsvRules.cell("say \"hi\""));
+        assertEquals("a b", CsvRules.cell("a\nb"));
+        assertEquals("", CsvRules.cell(null));
+    }
+    @Test public void document() {
+        String d = CsvRules.document(new String[]{"id", "status"}, Arrays.asList(new String[]{"1", "pending"}, new String[]{"2", "=x"}));
+        assertTrue(d.startsWith(CsvRules.BOM + "id,status\r\n"));
+        assertTrue(d.endsWith("2,'=x\r\n"));
+        assertEquals(CsvRules.BOM + "a\r\n", CsvRules.document(new String[]{"a"}, Collections.emptyList()));
+    }
+}
