+-- reset ANOTHER staff member's authenticator (yours: SQL editor, reset_admin_mfa)
+create or replace function public.admin_reset_mfa(uid uuid) returns text
+language plpgsql security definer set search_path = public, auth as $$
+declare em text; msg text;
+begin
+  perform public.require_permission('mfa_manage');
+  if uid = auth.uid() then raise exception 'use the SQL editor to reset your own two-step' using errcode = '42501'; end if;
+  select m.email into em from public.admin_members m where m.user_id = uid and m.role <> 'owner';
