+-- 040: BOFO Admin rebuild, Stage 2 (part 2 of 2): every admin action now needs its own permission. Run AFTER 039. Safe to run twice.
+--
+-- WHAT CHANGES
+--   A) The existing admin functions are re-created with the SAME names and signatures (the old app keeps calling them) but the
+--      check is no longer "is_admin()", it is the permission for that action (table below). The function bodies are otherwise
+--      byte-for-byte the latest versions from migrations 001..037 (generated by script, not retyped).
+--   B) Sensitive read policies move from is_admin() to a permission (payments, AI chat log, ID photos, banned list, owner-only items).
+--      Policies that only let staff READ ordinary app data (users, listings, reports view) keep using is_admin() = "any active staff".
+--      Policies that let staff WRITE (colleges, amenities, listing delete, review delete) now need a real permission.
+--   C) New owner-only wrappers for things that were SQL-editor-only: admin_set_min_app_version, admin_set_min_admin_app_version, admin_reset_mfa.
+--   D) S-05 (rate limit on check_id_number), S-17 (AI chat log owner-only + 90-day retention job).
+--
+-- PERMISSION TABLE (who has it: O owner, A admin, M moderator, S support; "own" = everyone staff)
+--   id_review O A M          review_verification, admin_approve_verification, admin_flag_second_opinion, idv_read for PENDING items only
+--   id_view_raw O            read ID photos outside a pending review
+--   reports_act O A M        admin_review_report (dismiss / reviewed / suspend <= 168 h), delete a review
+--   suspend_long O A         suspend > 168 h (a moderator sends request_admin_approval)
+--   ban_permanent O          ban (moderators and admins send a request; only the owner can approve it)
+--   unban O                  admin_unban
+--   listing_takedown O       admin_takedown, admin_report_takedown, delete a listing
+--   banned_view O A M S      admin_banned_list, read banned_identities
+--   payments_view/manage O   read payments + boosts, admin_refund_boost
+--   ai_settings O            set_ai_enabled, ai_chat_log_wipe       ai_log_view O   read ai_chat_log (S-17)
+--   ai_answer O A M S        read ai_unanswered / ai_feedback
+--   audit_view_all O         read audit_logs (old table) and admin_audit_log of everyone
+--   dashboard_view all staff send_test_push, push_test_result
+--   app_config O             colleges / amenities writes, min app version, reset MFA via mfa_manage
+--
+-- ROLLBACK: re-run the function files listed in the "-- from" comments (001, 003, 014, 023, 027, 030, 034, 037) to restore each old body,
+--   and re-create the old policies:  see "ROLLBACK POLICIES" at the bottom. Then roll back 039.
+
+-- ===================== A) re-created admin functions (same signatures, new permission checks) =====================
+-- from 023_ban.sql
+create or replace function public.review_verification(vid uuid, approve boolean, reason text) returns jsonb
+language plpgsql security definer set search_path = public as $$
+declare v public.owner_verifications;
+begin
+  perform public.require_permission('id_review');
+  if approve then raise exception 'use admin_approve_verification'; end if;
+  select * into v from public.owner_verifications where id = vid and status = 'pending';
+  if v.id is null then raise exception 'not pending'; end if;
+  if coalesce(trim(reason), '') = '' then raise exception 'reason required'; end if;
+  update public.owner_verifications set status = 'rejected', reviewed_by = auth.uid(), reviewed_at = now(), rejection_reason = reason where id = vid;
+  update public.users set is_verified = false, verification_status = 'rejected' where id = v.owner_id;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details)
+    values (auth.uid(), 'verification_rejected', 'owner_verification', vid::text, jsonb_build_object('owner_id', v.owner_id, 'reason', reason));
+  return '{}'::jsonb;
+end $$;
+
+
+-- from 023_ban.sql
+create or replace function public.admin_approve_verification(vid uuid, id_number text) returns jsonb
+language plpgsql security definer set search_path = public as $$
+declare v public.owner_verifications; h text;
+begin
+  perform public.require_permission('id_review');
+  select * into v from public.owner_verifications where id = vid and status = 'pending';
+  if v.id is null then raise exception 'not pending'; end if;
+  h := public.id_hash(v.id_type, id_number);
+  if v.id_hash is not null and v.id_hash <> h then raise exception 'ID number does not match the number the owner typed'; end if;
+  if exists (select 1 from public.banned_identities where id_hash = h and active) then raise exception 'this ID is banned'; end if;
+  -- a request sent before 2.1.9 has no stored hash: the admin's number is stored so a later ban can still block this ID
+  update public.owner_verifications set status = 'verified', id_hash = h, reviewed_by = auth.uid(), reviewed_at = now(), rejection_reason = null where id = vid;
+  update public.users set is_verified = true, verification_status = 'verified' where id = v.owner_id;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details)
+    values (auth.uid(), 'verification_approved', 'owner_verification', vid::text, jsonb_build_object('owner_id', v.owner_id, 'id_checked', true));
+  return '{}'::jsonb;
+end $$;
+
+
+-- from 034_second_opinion.sql
+create or replace function public.admin_flag_second_opinion(vid uuid, flag boolean) returns jsonb
+language plpgsql security definer set search_path = public as $$
+declare v public.owner_verifications;
+begin
+  perform public.require_permission('id_review');
+  select * into v from public.owner_verifications where id = vid and status = 'pending';
+  if v.id is null then raise exception 'not pending'; end if;
+  update public.owner_verifications
+     set needs_second_opinion = flag,
+         second_opinion_by = case when flag then auth.uid() else null end,
+         second_opinion_at = case when flag then now() else null end
+   where id = vid;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details)
+    values (auth.uid(), case when flag then 'verification_flagged' else 'verification_unflagged' end, 'owner_verification', vid::text,
+            jsonb_build_object('owner_id', v.owner_id));
+  return '{}'::jsonb;
+end $$;
+
+
+-- from 001_schema.sql
+create or replace function public.admin_takedown(bh uuid, reason text) returns jsonb
+language plpgsql security definer set search_path = public as $$
+begin
+  perform public.require_permission('listing_takedown');
+  update public.boarding_houses set status = 'taken_down' where id = bh;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details) values (auth.uid(), 'listing_takedown', 'boarding_house', bh::text, jsonb_build_object('reason', reason));
+  return '{}'::jsonb;
+end $$;
+
+
+-- from 027_reports_answered.sql
+create or replace function public.admin_report_takedown(rid uuid, bh uuid, reason text)
+returns jsonb language plpgsql security definer set search_path to 'public' as $$
+declare r public.reports; p public.boarding_houses; why text := left(btrim(coalesce(reason, '')), 300);
+begin
+  perform public.require_permission('listing_takedown');
+  if why = '' then raise exception 'a reason is required'; end if;
+  select * into r from public.reports where id = rid for update;
+  if not found then raise exception 'report not found'; end if;
+  if r.status <> 'pending' then raise exception 'this report was already handled'; end if;
+  select * into p from public.boarding_houses where id = bh;
+  if not found then raise exception 'place not found'; end if;
+  if p.owner_id is distinct from r.reported_user_id then raise exception 'this place does not belong to the reported user'; end if;
+  update public.boarding_houses set status = 'taken_down' where id = bh;
+  update public.reports set status = 'actioned', action = 'takedown', reviewed_by = auth.uid(), reviewed_at = now(),
+         admin_notes = left('Taken down: ' || p.name || ' - ' || why, 500) where id = rid;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details)
+    values (auth.uid(), 'report_takedown', 'boarding_house', bh::text, jsonb_build_object('report_id', rid, 'reason', why));
+  return jsonb_build_object('status', 'actioned');
+end $$;
+
+-- from 023_ban.sql
+create or replace function public.admin_unban(uid uuid, note text default null) returns jsonb
+language plpgsql security definer set search_path = public as $$
+declare nt text := nullif(left(btrim(coalesce(note, '')), 300), '');
+begin
+  perform public.require_permission('unban');
+  if not exists (select 1 from public.users where id = uid and banned_at is not null) then raise exception 'this user is not banned'; end if;
+  update public.users set banned_at = null, banned_by = null, ban_reason = null where id = uid;
+  update public.banned_identities set active = false, unbanned_at = now(), unbanned_by = auth.uid() where user_id = uid and active;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details)
+    values (auth.uid(), 'user_unban', 'user', uid::text, jsonb_build_object('note', nt));
+  return jsonb_build_object('ok', true);
+end $$;
+
+
+-- from 023_ban.sql
+create or replace function public.admin_banned_list()
+returns table (user_id uuid, full_name text, email text, ban_reason text, banned_at timestamptz, banned_by_name text, id_banned boolean)
+language plpgsql stable security definer set search_path = public, auth as $$
+begin
+  perform public.require_permission('banned_view');
+  return query
+    select u.id, nullif(u.full_name, ''), au.email::text, u.ban_reason, u.banned_at, nullif(b.full_name, ''),
+           exists (select 1 from public.banned_identities bi where bi.user_id = u.id and bi.active)
+    from public.users u
+    left join auth.users au on au.id = u.id
+    left join public.users b on b.id = u.banned_by
+    where u.banned_at is not null
+    order by u.banned_at desc;
+end $$;
+
+
+-- from 003_boosts.sql
+create or replace function public.admin_refund_boost(pid uuid, reason text) returns jsonb
+language plpgsql security definer set search_path = public as $$
+begin
+  perform public.require_permission('payments_manage');
+  update public.payments set status = 'refunded' where id = pid;
+  update public.boosts set ends_at = least(ends_at, now()), starts_at = least(starts_at, now() - interval '1 second') where payment_id = pid;
+  insert into public.audit_logs (actor_id, action, target_type, target_id, details)
+    values (auth.uid(), 'boost_refunded', 'payment', pid::text, jsonb_build_object('reason', reason));
+  return '{}'::jsonb;
+end $$;
+
+-- from 014_ai_chat_log.sql
+create or replace function public.ai_chat_log_wipe() returns jsonb
+language plpgsql security definer set search_path = public as $$
+declare n bigint;
+begin
+  perform public.require_permission('ai_settings');
+  delete from public.ai_chat_log where true;
+  get diagnostics n = row_count;
+  insert into public.audit_logs (actor_id, action, target_type, details)
+    values (auth.uid(), 'ai_chat_wipe', 'ai_chat_log', jsonb_build_object('rows', n));
+  return jsonb_build_object('deleted', n);
+end $$;
+
+-- from 030_ai_switch.sql
+create or replace function public.set_ai_enabled(on_ boolean) returns void
+language plpgsql security definer set search_path = public as $$
+begin
+  if auth.uid() is not null then perform public.require_permission('ai_settings'); end if;
+  insert into public.app_flags (key, value, updated_at) values ('ai_enabled', on_, now())
+    on conflict (key) do update set value = excluded.value, updated_at = now();
+  begin
+    insert into public.audit_logs (actor_id, action, target_type, details)
+      values (auth.uid(), case when on_ then 'ai_enabled_on' else 'ai_enabled_off' end, 'app_flags', jsonb_build_object('value', on_));
+  exception when others then null;   -- the audit line must never block the switch
+  end;
+end $$;
+
+-- from 037_push_test_admin.sql
+create or replace function public.send_test_push() returns jsonb
+language plpgsql security definer set search_path = public, extensions as $$
+declare u text; s text; rid bigint;
+begin
+  perform public.require_permission('dashboard_view');
+  select value into u from public.push_settings where key = 'url';
+  select value into s from public.push_settings where key = 'secret';
+  if u is null or s is null then return jsonb_build_object('stage', 'not_set_up'); end if;
+  select net.http_post(
+    url := u,
+    body := jsonb_build_object('kind', 'test', 'record', jsonb_build_object('as', 'me', 'user_id', auth.uid())),
+    headers := jsonb_build_object('Content-Type', 'application/json', 'x-bofo-push-secret', s)) into rid;
+  return jsonb_build_object('stage', 'sent', 'request_id', rid);
+end $$;
+
+
+-- from 037_push_test_admin.sql
+create or replace function public.push_test_result(rid bigint) returns jsonb
+language plpgsql security definer set search_path = public, extensions as $$
+declare r record;
+begin
+  perform public.require_permission('dashboard_view');
+  select status_code, left(content, 200) as answer, error_msg into r from net._http_response where id = rid;
+  if not found then return jsonb_build_object('ready', false); end if;
+  return jsonb_build_object('ready', true, 'status_code', r.status_code, 'answer', r.answer, 'error', r.error_msg);
+end $$;
