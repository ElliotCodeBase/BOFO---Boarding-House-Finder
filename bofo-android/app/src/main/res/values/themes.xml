<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v2.0.117: the look lives in Base.Theme.Bofo; Theme.Bofo only exists so values-v29 can add forceDarkAllowed=false on top of it.
         Both themes (classic purple / orange) are LIGHT: res/values-night/colors.xml is just the switch (AppCompatDelegate MODE_NIGHT_YES = orange). -->
    <style name="Base.Theme.Bofo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/bofo_primary</item>
        <item name="colorOnPrimary">@color/bofo_white</item>
        <item name="colorPrimaryContainer">@color/bofo_primary_tint</item>
        <item name="colorOnPrimaryContainer">@color/bofo_primary_dark</item>
        <item name="colorSecondary">@color/bofo_amber</item>
        <item name="colorOnSecondary">@color/bofo_ink</item>
        <item name="colorSecondaryContainer">@color/bofo_primary_tint</item>
        <item name="colorOnSecondaryContainer">@color/bofo_primary_dark</item>
        <item name="colorSurface">@color/bofo_white</item>
        <item name="colorOnSurface">@color/bofo_text</item>
        <item name="colorOnSurfaceVariant">@color/bofo_text_2</item>
        <item name="colorOutline">@color/bofo_muted</item>
        <item name="colorOutlineVariant">@color/bofo_border</item>
        <item name="android:colorBackground">@color/bofo_bg</item>
        <item name="colorError">@color/bofo_error</item>
        <item name="colorErrorContainer">@color/bofo_error_tint</item>
        <item name="android:windowBackground">@color/bofo_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Bofo.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Bofo.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Bofo.Large</item>
    </style>

    <style name="Theme.Bofo" parent="Base.Theme.Bofo" />

    <!-- v2.0.117 Launch theme (manifest, the very first frame). The system draws this window BEFORE the app runs, so it follows the phone's own
         light / dark setting, not the in-app switch. Default = orange, so it is the white loading screen colour (launch_bg_orange).
         Android 13+ also gets Theme.Bofo.Launch.Classic (dark ink) when the user picks Classic: MainActivity calls SplashScreen.setSplashScreenTheme.
         MainActivity switches back to Theme.Bofo before it inflates anything (setTheme in onCreate). -->
    <style name="Theme.Bofo.Launch" parent="Theme.Bofo">
        <item name="android:windowBackground">@color/launch_bg_orange</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Bofo.Launch.Classic" parent="Theme.Bofo.Launch">
        <item name="android:windowBackground">@color/launch_bg_classic</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Shape.Bofo.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Shape.Bofo.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.Bofo.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
