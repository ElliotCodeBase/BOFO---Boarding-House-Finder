<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from bofo.css: .btn-primary (pill), .btn-cta (ink, 16), .btn-tint, .card (white, 1px line, 16) -->
<resources>
    <style name="Widget.Bofo.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/bofo_primary</item>
        <item name="android:textColor">@color/bofo_white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.Bofo.Button.Cta" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/bofo_ink</item>
        <item name="android:textColor">@color/bofo_white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.Bofo.Button.Tint" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bofo_tile</item>
        <item name="android:textColor">@color/bofo_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <!-- v2.0.61: white pill on the map (same look as the round back button): campus icon + name, never a wide lavender bar. -->
    <style name="Widget.Bofo.Button.MapPill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/bofo_white</item>
        <item name="android:textColor">@color/bofo_primary_dark</item>
        <item name="strokeColor">@color/bofo_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="icon">@drawable/ic_campus_dot</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@null</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">3dp</item>
    </style>
    <style name="Widget.Bofo.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/bofo_white</item>
        <item name="strokeColor">@color/bofo_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Text.Bofo.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/bofo_text</item>
        <!-- v2.0.96 plain medium weight (condensed bold looked heavy). To use a real font: add res/font/<name>.ttf and put @font/<name> here. -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Text.Bofo.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/bofo_text_2</item>
    </style>
    <style name="Text.Bofo.Splash" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/bofo_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Form.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/bofo_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Form.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chat_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/bofo_text</item>
        <item name="android:textColorHint">@color/bofo_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- v2.0.95 section label: sentence case, quiet. Replaces the tracked ALL-CAPS labels. -->
    <style name="Text.Bofo.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/bofo_text_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- price figure: ink, medium weight -->
    <style name="Text.Bofo.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/bofo_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Shape.Bofo.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
