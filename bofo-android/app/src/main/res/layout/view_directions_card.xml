<?xml version="1.0" encoding="utf-8"?>
<!-- Content of DirectionsCardView (a MaterialCardView, styled by the caller with Widget.Bofo.Card). Nothing here has a fixed width:
     the three tabs share the row, every text wraps, every button takes the full row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dir_title"
        android:textColor="@color/bofo_text"
        android:textSize="16sp"
        android:textStyle="bold" />


    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/tab_me_bh"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="2"
            android:minHeight="44dp"
            android:paddingHorizontal="2dp"
            android:text="@string/dir_tab_me_bh"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_bh_campus"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="2"
            android:minHeight="44dp"
            android:paddingHorizontal="2dp"
            android:text="@string/dir_tab_bh_campus"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_me_campus"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="2"
            android:minHeight="44dp"
            android:paddingHorizontal="2dp"
            android:text="@string/dir_tab_me_campus"
            android:textSize="12sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.bofo.finder.ui.MapCardView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="10dp" />

    <!-- From / To -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/bg_dir_dot_from" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/dir_from"
                android:textAppearance="@style/Text.Bofo.Secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/from_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/bofo_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:layout_marginStart="5dp"
            android:layout_marginVertical="2dp"
            android:background="@color/bofo_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_dir_dot_to" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/dir_to"
                android:textAppearance="@style/Text.Bofo.Secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/to_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/bofo_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- waiting for the plan -->
    <LinearLayout
        android:id="@+id/dir_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dir_finding"
            android:textAppearance="@style/Text.Bofo.Secondary" />
    </LinearLayout>

    <!-- something is missing (no campus / no position) or the plan failed -->
    <LinearLayout
        android:id="@+id/message_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dir_note"
            android:padding="10dp"
            android:textColor="@color/bofo_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_locate"
            style="@style/Widget.Bofo.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dir_use_location"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_instead"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dir_show_bh_campus_instead"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dir_try_again"
            android:visibility="gone" />
    </LinearLayout>

    <!-- the plan -->
    <LinearLayout
        android:id="@+id/plan_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dir_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/hero_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bofo_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.Bofo.Secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/single_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/Text.Bofo.Secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ways_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dir_ways"
            android:textColor="@color/bofo_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_far_campus"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dir_show_bh_campus"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_osm"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="@string/dir_open_osm" />

            <Button
                android:id="@+id/btn_more"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="@string/dir_more" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
