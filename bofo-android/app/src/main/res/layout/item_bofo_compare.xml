<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0.60: comparison table inside the chat; header, rows and the "most wins" line are added in code (BofoChatOverlay.addCompare).
     Columns share the width; scrolls sideways when it does not fit. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_bofo_result"
    android:clipToOutline="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/table"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</HorizontalScrollView>
