<?xml version="1.0" encoding="utf-8"?>
<!-- v2.9.8: "Last 7 days" as three small stats (number, label, change vs the 7 days before). Not tappable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_dash_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_adm_icon_tile"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Bofo.Label"
                android:textColor="@color/bofo_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/card_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/admin_week_sub"
                android:textAppearance="@style/Text.Bofo.Secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_stat"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/wk_users_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Bofo.Title"
                android:textColor="@color/bofo_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_week_users"
                android:textAppearance="@style/Text.Bofo.Label"
                android:textColor="@color/bofo_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wk_users_d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.Bofo.Secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_stat"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/wk_listings_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Bofo.Title"
                android:textColor="@color/bofo_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_week_listings"
                android:textAppearance="@style/Text.Bofo.Label"
                android:textColor="@color/bofo_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wk_listings_d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.Bofo.Secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_week_stat"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/wk_resolved_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Bofo.Title"
                android:textColor="@color/bofo_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_week_resolved"
                android:textAppearance="@style/Text.Bofo.Label"
                android:textColor="@color/bofo_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wk_resolved_d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.Bofo.Secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
