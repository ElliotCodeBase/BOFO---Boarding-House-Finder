<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/mfa_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mfa_title"
        android:textAppearance="@style/Text.Bofo.Title"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/mfa_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/Text.Bofo.Secondary" />

    <LinearLayout
        android:id="@+id/mfa_key_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mfa_key_label"
            android:textAppearance="@style/Text.Bofo.Label" />

        <TextView
            android:id="@+id/mfa_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/bofo_text"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:typeface="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mfa_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mfa_copy" />

            <Button
                android:id="@+id/mfa_open"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mfa_open_app" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/mfa_code"
        style="@style/Widget.Form.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/mfa_code_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="6"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mfa_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/bofo_error"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/mfa_primary"
        style="@style/Widget.Bofo.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/mfa_loading" />

    <Button
        android:id="@+id/mfa_turn_off"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mfa_turn_off"
        android:textColor="@color/bofo_error"
        android:visibility="gone" />
</LinearLayout>
