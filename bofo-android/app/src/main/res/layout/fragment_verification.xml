<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bofo_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bofo_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/verify_title"
            android:textColor="@color/bofo_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="@color/bofo_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/verify_loading"
                android:textAppearance="@style/Text.Bofo.Secondary" />

            <Button
                android:id="@+id/retry"
                style="@style/Widget.Bofo.Button.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/verify_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/verify_intro"
                    android:textAppearance="@style/Text.Bofo.Secondary" />

                <TextView style="@style/Text.Form.Label" android:text="@string/verify_id_type" />
                <Button
                    android:id="@+id/idType"
                    style="@style/Widget.Bofo.Button.Tint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView style="@style/Text.Form.Label" android:text="@string/verify_front" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/frontThumb"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_skeleton"
                        android:contentDescription="@string/verify_front"
                        android:scaleType="centerCrop" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/frontNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/verify_none"
                            android:textAppearance="@style/Text.Bofo.Secondary" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/frontTake"
                                style="@style/Widget.Bofo.Button.Tint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/verify_take" />
                            <Button
                                android:id="@+id/frontPick"
                                style="@style/Widget.Bofo.Button.Tint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/verify_choose" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/Text.Form.Label" android:text="@string/verify_back" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/backThumb"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_skeleton"
                        android:contentDescription="@string/verify_back"
                        android:scaleType="centerCrop" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/backNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/verify_none"
                            android:textAppearance="@style/Text.Bofo.Secondary" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/backTake"
                                style="@style/Widget.Bofo.Button.Tint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/verify_take" />
                            <Button
                                android:id="@+id/backPick"
                                style="@style/Widget.Bofo.Button.Tint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/verify_choose" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/Text.Form.Label" android:text="@string/verify_selfie" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/verify_selfie_hint"
                    android:textAppearance="@style/Text.Bofo.Secondary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/selfieThumb"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_skeleton"
                        android:contentDescription="@string/verify_selfie"
                        android:scaleType="centerCrop" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/selfieNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/verify_none"
                            android:textAppearance="@style/Text.Bofo.Secondary" />
                        <Button
                            android:id="@+id/selfieTake"
                            style="@style/Widget.Bofo.Button.Tint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/verify_take_selfie" />
                    </LinearLayout>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/consent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/verify_consent"
                    android:textColor="@color/bofo_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/errors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/bofo_error_tint"
                    android:padding="12dp"
                    android:textColor="@color/bofo_error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/submit"
                    style="@style/Widget.Bofo.Button.Cta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/verify_submit" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
