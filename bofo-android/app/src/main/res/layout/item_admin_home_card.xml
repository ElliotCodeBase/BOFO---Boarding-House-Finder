<?xml version="1.0" encoding="utf-8"?>
<!-- v2.9.8: icon tile + title/sub + count (or a chevron for tool cards). The card background and colours are set in AdminHomeFragment.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_dash_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/card_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_adm_icon_tile"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Bofo.Label"
            android:textColor="@color/bofo_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/card_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.Bofo.Secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minWidth="32dp"
        android:gravity="end"
        android:textAppearance="@style/Text.Bofo.Title"
        android:textColor="@color/bofo_primary" />

    <ImageView
        android:id="@+id/card_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone" />
</LinearLayout>
