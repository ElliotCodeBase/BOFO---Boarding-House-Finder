<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.0 one Boarding group message: day chip, sender name + role badge, bubble, time. Gravity (start / end) is set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:background="@drawable/bg_day_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/bofo_text_2"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/who"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="@color/bofo_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- announcement card (v2.4.8 notice look): plain white sheet, hairline border, small corners. No icon, no coloured border, no pill:
         a quiet label + "Pinned" in text, title, text, then "Seen by N" (owner) or a text "Got it" (members). -->
    <LinearLayout
        android:id="@+id/ann"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ann_notice"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/boarding_announcement"
                android:textColor="@color/bofo_text_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ann_pinned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/boarding_pinned_label"
                android:textColor="@color/bofo_role_owner_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ann_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/bofo_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ann_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/bofo_text"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/ann_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ann_seen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bofo_text_2"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ann_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boarding_got_it_done"
                android:textColor="@color/bofo_text_2"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/got_it"
                style="@style/Widget.Bofo.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/boarding_got_it"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.15"
        android:maxWidth="290dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:textIsSelectable="false"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="5dp"
        android:paddingHorizontal="6dp"
        android:textColor="@color/bofo_muted"
        android:textSize="11sp" />
</LinearLayout>
