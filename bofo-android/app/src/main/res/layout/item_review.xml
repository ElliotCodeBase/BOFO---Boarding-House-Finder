<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/reviewer_photo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_avatar"
        android:src="@drawable/mascot_happy" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reviewer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bofo_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/review_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bofo_amber"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/review_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bofo_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/review_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bofo_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
