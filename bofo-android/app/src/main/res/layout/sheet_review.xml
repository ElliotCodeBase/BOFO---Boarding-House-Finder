<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/review_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/review_sheet_title"
        android:textAppearance="@style/Text.Bofo.Title"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/review_sheet_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.Bofo.Secondary" />

    <LinearLayout
        android:id="@+id/review_stars_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/review_rating_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/review_pick_rating"
        android:textAppearance="@style/Text.Bofo.Label" />

    <EditText
        android:id="@+id/review_comment_input"
        style="@style/Widget.Form.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="top|start"
        android:hint="@string/review_sheet_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="1000"
        android:minHeight="110dp"
        android:paddingVertical="12dp" />

    <TextView
        android:id="@+id/review_comment_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:textColor="@color/bofo_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/review_submit"
        style="@style/Widget.Bofo.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/review_submit" />

    <Button
        android:id="@+id/review_delete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/review_delete"
        android:textColor="@color/bofo_error"
        android:visibility="gone" />
</LinearLayout>
