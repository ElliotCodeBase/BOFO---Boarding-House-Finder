<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textAppearance="@style/Text.Bofo.Title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Bofo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/cd_avatar"
                    android:src="@drawable/mascot_happy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/account_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.Bofo.Title"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/account_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.Bofo.Secondary" />

                    <TextView
                        android:id="@+id/account_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/bofo_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/open_edit"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_edit" />

        <Button
            android:id="@+id/open_settings"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_settings" />

        <!-- v2.0.91 AI Chats monitor: hidden; ProfileFragment shows it for an admin while the switch is on. REMOVE with the feature (REMOVE_AI_CHATS.md). -->
        <Button
            android:id="@+id/ai_chats_open"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ai_chats_open"
            android:visibility="gone" />

        <!-- About (version comes from BuildConfig.VERSION_NAME, set in ProfileFragment) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_title"
            android:textAppearance="@style/Text.Bofo.Secondary"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Bofo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="@string/cd_mascot"
                    android:src="@drawable/mascot_happy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_brand"
                    android:textAppearance="@style/Text.Bofo.Title"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/Text.Bofo.Secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Debug builds only (set visible in ProfileFragment). Removed with the "Developer" tools in Stage 9. -->
        <Button
            android:id="@+id/debug_open"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/debug_open"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
