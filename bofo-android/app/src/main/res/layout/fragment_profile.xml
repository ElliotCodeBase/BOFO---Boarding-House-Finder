<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0.95 Profile: left-aligned ID panel with a key-tag role, flat hairline rows (no stack of identical cards), sentence-case labels. All view ids are unchanged. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="120dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textAppearance="@style/Text.Bofo.Title"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_profile_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/cd_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/mascot_happy"
                app:shapeAppearanceOverlay="@style/Shape.Bofo.Avatar"
                app:strokeColor="@color/bofo_amber"
                app:strokeWidth="3dp"
                android:padding="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/Text.Bofo.Title"
                    android:textColor="@color/bofo_white"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/account_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B9B4DD"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/account_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_profile_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/bofo_ink"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/profile_section_account"
            android:textAppearance="@style/Text.Bofo.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:divider="@drawable/divider_set_inset"
            android:orientation="vertical"
            android:showDividers="middle">
                <TextView
                    android:id="@+id/open_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="14dp"
                    android:drawableStart="@drawable/ic_set_edit"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/profile_edit"
                    android:textColor="@color/bofo_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/open_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="14dp"
                    android:drawableStart="@drawable/ic_set_sliders"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/profile_settings"
                    android:textColor="@color/bofo_text"
                    android:textSize="15sp" />
                <!-- v2.0.91 AI Chats monitor: hidden; ProfileFragment shows it for an admin while the switch is on. REMOVE with the feature (REMOVE_AI_CHATS.md). -->
                <TextView
                    android:id="@+id/ai_chats_open"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="14dp"
                    android:drawableStart="@drawable/ic_set_chat"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/ai_chats_open"
                    android:textColor="@color/bofo_text"
                    android:textSize="15sp"
                    android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/bofo_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/about_title"
            android:textAppearance="@style/Text.Bofo.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_mascot"
                android:src="@drawable/mascot_happy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_brand"
                    android:textAppearance="@style/Text.Bofo.Title"
                    android:textSize="18sp" />

                <!-- version comes from BuildConfig.VERSION_NAME, set in ProfileFragment -->
                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textAppearance="@style/Text.Bofo.Secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Debug builds only (set visible in ProfileFragment). -->
        <Button
            android:id="@+id/debug_open"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/debug_open"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
