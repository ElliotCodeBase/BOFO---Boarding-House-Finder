<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0.81: one card of the Explore map strip (same design as the v2.0.79 peek card, without the close X). The width is set from code. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Bofo.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="@color/bofo_white"
    app:cardElevation="6dp"
    app:strokeColor="@color/bofo_stroke_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_peek_icon"
                android:importantForAccessibility="no"
                android:padding="19dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/bofo_primary" />

            <ImageView
                android:id="@+id/strip_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/strip_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.005"
                android:maxLines="2"
                android:textColor="@color/bofo_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strip_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/bofo_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strip_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textAppearance="@style/Text.Bofo.Secondary" />

            <!-- v2.0.83: Commute action; becomes the one-line result (mode + minutes) once the route is drawn -->
            <TextView
                android:id="@+id/strip_commute"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_commute_chip"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_commute"
                android:drawableTint="@color/commute_chip_fg"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:text="@string/map_commute"
                android:textColor="@color/commute_chip_fg"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/strip_open"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_peek_open"
            android:contentDescription="@string/cd_peek_open"
            android:elevation="2dp"
            android:padding="12dp"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/bofo_white" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
