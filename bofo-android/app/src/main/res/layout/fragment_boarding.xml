<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.0 Boarding tab (student): join with the owner's code, or the group chat of the house you live in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bofo_bg">

    <FrameLayout
        android:id="@+id/chat_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/join_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:text="@string/boarding_title"
                android:textAppearance="@style/Text.Bofo.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="40dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/mascot_happy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/boarding_join_title"
                    android:textColor="@color/bofo_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/boarding_join_sub"
                    android:textAppearance="@style/Text.Bofo.Secondary" />

                <EditText
                    android:id="@+id/code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:autofillHints="no"
                    android:background="@drawable/bg_chat_input"
                    android:gravity="center"
                    android:hint="@string/boarding_code_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:letterSpacing="0.15"
                    android:maxLength="12"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:textColor="@color/bofo_text"
                    android:textColorHint="@color/bofo_muted"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/join_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/bofo_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/join"
                    style="@style/Widget.Bofo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/boarding_join" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/error_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/Text.Bofo.Secondary" />

        <Button
            android:id="@+id/retry"
            style="@style/Widget.Bofo.Button.Tint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/common_try_again" />
    </LinearLayout>
</FrameLayout>
