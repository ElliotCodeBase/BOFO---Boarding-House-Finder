<?xml version="1.0" encoding="utf-8"?>
<!-- v2.4.2 AI Announcement Writer step 5: the "Write for me" sheet. v2.4.7: the sheet opens on the details form; the type is chosen from a searchable
     dropdown at its top (AnnounceTypeDropdown), the old full-screen type list (stage A) is gone;
     v2.4.3 step 6 adds stage C (ann_stage_result: loading / error / draft). AnnounceAiSheet shows one of them. The 4 input slots are fixed views so Android restores what the owner typed after a rotation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ann_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/ann_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/announce_back_details_cd"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/bofo_text" />

        <TextView
            android:id="@+id/ann_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/announce_pick_type_title"
            android:textAppearance="@style/Text.Bofo.Title"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/ann_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/announce_close_cd"
            android:src="@drawable/ic_bofo_close"
            app:tint="@color/bofo_text" />
    </LinearLayout>

    <!-- the form: type dropdown + details -->
    <LinearLayout
        android:id="@+id/ann_stage_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ann_type_layout"
                    style="@style/Widget.Bofo.RdField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/announce_type_hint"
                    app:endIconContentDescription="@string/announce_type_hint"
                    app:endIconDrawable="@drawable/ic_chevron_down"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ann_type_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:maxLines="1"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/ann_type_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/announce_type_start"
                    android:textAppearance="@style/Text.Bofo.RdCaption" />

                <LinearLayout
                    android:id="@+id/ann_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:id="@+id/ann_type_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.Bofo.RdCaption" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/announce_details_intro"
                    android:textAppearance="@style/Text.Bofo.RdCaption" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ann_field_1"
                style="@style/Widget.Bofo.RdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ann_input_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                    android:maxLength="200"
                    android:maxLines="3"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ann_field_2"
                style="@style/Widget.Bofo.RdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ann_input_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                    android:maxLength="200"
                    android:maxLines="3"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ann_field_3"
                style="@style/Widget.Bofo.RdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ann_input_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                    android:maxLength="200"
                    android:maxLines="3"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ann_field_4"
                style="@style/Widget.Bofo.RdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ann_input_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                    android:maxLength="200"
                    android:maxLines="3"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/announce_options_title"
                    android:textAppearance="@style/Text.Bofo.RdSection" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/announce_label_language"
                android:textAppearance="@style/Text.Bofo.Label" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ann_lang_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/announce_label_tone"
                android:textAppearance="@style/Text.Bofo.Label" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ann_tone_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/announce_label_length"
                android:textAppearance="@style/Text.Bofo.Label" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ann_length_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ann_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/announce_option_emoji" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ann_closing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/announce_option_closing" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ann_closing_layout"
                    style="@style/Widget.Bofo.RdField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/announce_closing_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ann_closing_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="60"
                        android:maxLines="1"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ann_write"
            style="@style/Widget.Bofo.Button.RdAccent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:text="@string/announce_write_for_me" />
    </LinearLayout>

    <!-- stage C (v2.4.3): loading, error or the draft; the sheet shows exactly one of the three blocks -->
    <FrameLayout
        android:id="@+id/ann_stage_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ann_res_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/announce_writing"
                android:textAppearance="@style/Text.Bofo.RdSection" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ann_res_cancel"
                style="@style/Widget.Bofo.Button.RdTool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="@string/announce_cancel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ann_res_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ann_res_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Bofo.Body"
                android:textColor="@color/bofo_error_deep" />

            <TextView
                android:id="@+id/ann_res_error_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/announce_err_write_yourself"
                android:textAppearance="@style/Text.Bofo.RdCaption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ann_res_retry"
                style="@style/Widget.Bofo.Button.RdAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/announce_adjust_again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ann_res_error_details"
                style="@style/Widget.Bofo.Button.RdTool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/announce_edit_details" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ann_res_draft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/ann_res_degraded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/announce_degraded_note"
                        android:textAppearance="@style/Text.Bofo.RdCaption"
                        android:textColor="@color/bofo_error_deep"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ann_res_title_layout"
                        style="@style/Widget.Bofo.RdField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/announce_draft_title_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ann_res_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="120"
                            android:maxLines="3"
                            android:minHeight="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ann_res_message_layout"
                        style="@style/Widget.Bofo.RdField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/announce_draft_message_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ann_res_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="1000"
                            android:minLines="6" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/ann_res_counter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:textAppearance="@style/Text.Bofo.RdCaption" />

                    <TextView
                        android:id="@+id/ann_res_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/Text.Bofo.RdCaption"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/announce_check_before_posting"
                        android:textAppearance="@style/Text.Bofo.RdCaption" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ann_res_again"
                                style="@style/Widget.Bofo.Button.RdTool"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/announce_adjust_again" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ann_res_shorter"
                                style="@style/Widget.Bofo.Button.RdTool"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/announce_adjust_shorter" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ann_res_friendlier"
                                style="@style/Widget.Bofo.Button.RdTool"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/announce_adjust_friendlier" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ann_res_formal"
                                style="@style/Widget.Bofo.Button.RdTool"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/announce_adjust_formal" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/announce_change_language"
                        android:textAppearance="@style/Text.Bofo.Label" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/ann_res_lang_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ann_res_details"
                        style="@style/Widget.Bofo.Button.RdTool"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="@string/announce_edit_details" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ann_use"
                style="@style/Widget.Bofo.Button.RdAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:text="@string/announce_use_this" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
