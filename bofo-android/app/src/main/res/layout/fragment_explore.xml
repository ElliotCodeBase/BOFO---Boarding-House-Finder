<?xml version="1.0" encoding="utf-8"?>
<!-- Step 9: Explore = title + subtitle, search pill + square filter button, List | Map control, results. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:text="@string/tab_explore"
        android:textAppearance="@style/Text.Bofo.Title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:text="@string/ex_subtitle"
        android:textAppearance="@style/Text.Bofo.Secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/search_pill"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:autofillHints="@null"
                android:background="@null"
                android:hint="@string/explore_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/bofo_text"
                android:textColorHint="@color/bofo_muted"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/search_clear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ex_icon_btn"
                android:contentDescription="@string/ex_close_cd"
                android:padding="9dp"
                android:src="@drawable/ic_x_dark"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp">

            <ImageButton
                android:id="@+id/filter_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ex_filter_btn"
                android:contentDescription="@string/ex_filter_cd"
                android:padding="14dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/bofo_ink" />

            <TextView
                android:id="@+id/filter_badge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_ex_badge"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingHorizontal="5dp"
                android:textColor="@color/bofo_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/result_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/bofo_text_2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/seg"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_ex_seg_wrap"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/seg_list"
                style="@style/Text.Bofo.Seg"
                android:text="@string/ex_seg_list" />

            <TextView
                android:id="@+id/seg_map"
                style="@style/Text.Bofo.Seg"
                android:text="@string/ex_seg_map" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/area"
        layout="@layout/view_list_area" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/map_frame"
        style="@style/Widget.Bofo.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="28dp">

        <com.bofo.finder.ui.MapCardView
            android:id="@+id/map_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.bofo.finder.ui.CornerMaskView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
