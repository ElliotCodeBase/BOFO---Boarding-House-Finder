<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bofo_bg"
    android:clipChildren="false">

    <!-- The MapView is added here from code (after MapLibre is initialised). -->
    <FrameLayout
        android:id="@+id/map_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_attribution"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/map_attribution"
        android:textColor="@color/bofo_text_2"
        android:gravity="center"
        android:textSize="10sp" />

    <!-- Locate button: round, white, bottom-right (expand sits above it and is only shown where a screen asks for it) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:clipChildren="false"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/expand"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_map_button"
            android:contentDescription="@string/cd_map_full"
            android:src="@drawable/ic_expand"
            android:visibility="gone" />

        <!-- v2.0.78: the ring grows out of the button while the phone is being found (outside the 44 dp box, so nothing clips) -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clipChildren="false">

            <View
                android:id="@+id/locate_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_locate_ring"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <ImageButton
                android:id="@+id/locate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_button"
                android:contentDescription="@string/cd_locate"
                android:src="@drawable/ic_my_location" />
        </FrameLayout>
    </LinearLayout>

    <!-- Step 5: glass pill with the location state, top-left (hidden while the radius pill is shown) -->
    <TextView
        android:id="@+id/loc_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/bofo_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Radius pill, top-centre, shown when a campus (or Near me) is the centre -->
    <LinearLayout
        android:id="@+id/radius_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/bg_radius_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/radius_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="46dp"
            android:textColor="@color/bofo_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/radius_slider"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/cd_map_radius"
            android:stepSize="0.5"
            android:valueFrom="0.5"
            android:valueTo="5"
            android:value="3"
            app:haloRadius="14dp"
            app:labelBehavior="gone"
            app:minTouchTargetSize="40dp"
            app:thumbColor="@color/bofo_white"
            app:thumbElevation="2dp"
            app:thumbRadius="8dp"
            app:thumbStrokeColor="@color/bofo_ink"
            app:thumbStrokeWidth="2dp"
            app:trackColorActive="@color/bofo_ink"
            app:trackColorInactive="#E3E3EA"
            app:trackHeight="3dp" />
    </LinearLayout>

    <!-- Step 6 / v2.0.79: preview card: photo (house icon until it loads), name, price, rating + distance, small X closes, round > opens the place -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/peek"
        style="@style/Widget.Bofo.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="26dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="68dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="#E7E2FB">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_peek_icon"
                    android:importantForAccessibility="no"
                    android:padding="19dp"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/bofo_primary" />

                <ImageView
                    android:id="@+id/peek_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/peek_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="-0.005"
                    android:maxLines="2"
                    android:textColor="@color/bofo_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/peek_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/bofo_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/peek_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/Text.Bofo.Secondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/peek_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_peek_close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bofo_close"
                app:tint="@color/bofo_muted" />

            <ImageButton
                android:id="@+id/peek_open"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_peek_open"
                android:contentDescription="@string/cd_peek_open"
                android:elevation="2dp"
                android:padding="12dp"
                android:rotation="180"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/bofo_white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
