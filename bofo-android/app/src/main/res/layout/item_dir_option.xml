<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_dir_option"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/opt_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_dir_icon"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/opt_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_badge_amber"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/dir_best"
            android:textColor="@color/bofo_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/opt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bofo_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/opt_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.Bofo.Secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/opt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/bofo_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/opt_fare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@style/Text.Bofo.Secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
