<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3: white search pill (original college-box). Purple outline while the field is focused (view.setActivated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bofo_white" />
            <stroke android:width="1.5dp" android:color="@color/bofo_primary" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bofo_white" />
            <stroke android:width="1dp" android:color="#E7E2FB" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
