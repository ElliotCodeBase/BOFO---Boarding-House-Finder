<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0.85: Commute chip: soft lavender with an indigo outline (reads as a button on the card); filled indigo while it shows the result -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bofo_primary" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bofo_chip_tint" />
            <stroke android:width="1dp" android:color="@color/bofo_chip_stroke" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
