<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.5: tappable white row card (borders carry the edge, no shadow) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/bofo_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bofo_white" />
            <stroke android:width="1dp" android:color="@color/bofo_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
